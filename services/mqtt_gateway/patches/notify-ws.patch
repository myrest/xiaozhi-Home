     // 通过clientId查找连接
+    notificationKey(mac, clientId, reminderId, revision) {
+        return `${mac.toLowerCase()}|${clientId}|${reminderId}|${revision}`;
+    }
+
+    pruneNotificationRecords(nowSeconds = Math.floor(Date.now() / 1000)) {
+        for (const [key, record] of this.notificationRecords) {
+            if (record.expiresAt + 300 < nowSeconds) this.notificationRecords.delete(key);
+        }
+        while (this.notificationRecords.size > 10000) {
+            this.notificationRecords.delete(this.notificationRecords.keys().next().value);
+        }
+    }
+
+    registerNotification(connection, payload) {
+        this.pruneNotificationRecords();
+        const key = this.notificationKey(connection.macAddress, connection.clientId, payload.reminder_id, payload.revision);
+        const payloadHash = crypto.createHash('sha256').update(JSON.stringify(payload)).digest('hex');
+        const existing = this.notificationRecords.get(key);
+        if (existing) {
+            if (existing.payloadHash !== payloadHash) throw new Error('Conflicting notification revision');
+            return;
+        }
+        this.notificationRecords.set(key, {
+            mac: connection.macAddress.toLowerCase(),
+            clientId: connection.clientId,
+            reminderId: payload.reminder_id,
+            revision: payload.revision,
+            expiresAt: payload.expires_at,
+            payloadHash,
+            type: payload.type,
+            receipt: null
+        });
+    }
+
+    recordNotificationAck(connection, ack, topic) {
+        if (!connection.notificationAuthenticated || topic !== 'device-server' ||
+            !ack || typeof ack !== 'object' || Array.isArray(ack)) return;
+        const keys = Object.keys(ack).sort();
+        if (keys.length !== 4 || keys.join(',') !== 'reminder_id,revision,status,type' ||
+            ack.type !== 'notify_ack' || !NotificationUuidRegex.test(ack.reminder_id) ||
+            !Number.isSafeInteger(ack.revision) || ack.revision < 0 ||
+            !NotificationAckStatuses.has(ack.status)) return;
+
+        const now = Math.floor(Date.now() / 1000);
+        this.pruneNotificationRecords(now);
+        const key = this.notificationKey(connection.macAddress, connection.clientId, ack.reminder_id, ack.revision);
+        const record = this.notificationRecords.get(key);
+        if (!record || record.mac !== connection.macAddress.toLowerCase() ||
+            record.clientId !== connection.clientId || now > record.expiresAt + 300) return;
+        if (record.type === 'notify_cancel' && !['received', 'stopped'].includes(ack.status)) return;
+
+        const rank = status => ({ failed: 0, received: 1, playing: 2, completed: 3, stopped: 3, expired: 3 }[status] ?? -1);
+        if (record.receipt && rank(record.receipt.status) >= rank(ack.status)) return;
+        record.receipt = { status: ack.status, revision: ack.revision, received_at: now };
+    }
+
+    formatNotificationReceipt(record) {
+        if (!record?.receipt) return null;
+        if (record.type === 'notify_cancel' && record.receipt.status === 'stopped') {
+            return { ...record.receipt, status: 'cancelled' };
+        }
+        return record.receipt;
+    }
+
+    getNotificationReceipt(mac, reminderId, revision) {
+        this.pruneNotificationRecords();
+        const connection = this.getConnectionByMac(mac);
+        if (connection) {
+            const key = this.notificationKey(mac, connection.clientId, reminderId, revision);
+            const record = this.notificationRecords.get(key);
+            if (record?.receipt) return this.formatNotificationReceipt(record);
+        }
+        // Receipts remain queryable after disconnect or client credential rotation.
+        for (const record of this.notificationRecords.values()) {
+            if (record.mac === mac.toLowerCase() && record.reminderId === reminderId &&
+                record.revision === revision) return this.formatNotificationReceipt(record);
+        }
+        return null;
+    }
